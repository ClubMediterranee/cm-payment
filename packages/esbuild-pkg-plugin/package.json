{
  "name": "@clubmed/esbuild-cjs-shim-plugin",
  "version": "1.273.0",
  "description": "Generate CJS shim",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./cjsShim.js": "./dist/utils/cjsShim.js"
  },
  "keywords": [
    "esbuild",
    "pkg"
  ],
  "scripts": {
    "build:lib": "tsup-node ./src/index.ts ./src/utils/cjsShim.ts --format cjs,esm --dts --shims"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "change-case": "^5.4.4",
    "esbuild": "0.21.5",
    "fs-extra": "11.2.0",
    "tsup": "^8.5.1"
  }
}
