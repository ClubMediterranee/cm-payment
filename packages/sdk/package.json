{
  "name": "@clubmed/caps",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "author": "Club Med",
  "license": "BSD-3-Clause",
  "main": "index.js",
  "exports": {
    ".": "./dist/index.js",
    "./components/*": {
      "source": "./src/components/*",
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js",
      "default": "./dist/components/*.js"
    },
    "./contexts/*": {
      "source": "./src/contexts/*",
      "types": "./contexts/*.d.ts",
      "import": "./contexts/*.js",
      "default": "./contexts/*.js"
    },
    "./providers/*": {
      "source": "./src/providers/*",
      "types": "./providers/*.d.ts",
      "import": "./providers/*.js",
      "default": "./providers/*.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "import": "./dist/hooks/*.js",
      "default": "./dist/hooks/*.js"
    },
    "./types/*": {
      "types": "./dist/types/*.d.ts",
      "import": "./dist/types/*.js",
      "default": "./dist/types/*.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "generate:types": "orval",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.59.13",
    "@types/js-cookie": "^3.0.6",
    "classnames": "^2.5.1",
    "clsx": "^2.0.0",
    "js-cookie": "^3.0.5",
    "react-error-boundary": "^6.0.0",
    "react-hook-form": "^7.53.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "@clubmed/trident-icons": ">=1.3.3",
    "@clubmed/trident-ui": "1.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "msw": "^2.11.3"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
