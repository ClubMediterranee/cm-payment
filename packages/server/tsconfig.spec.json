{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": ".",
    "noEmit": true,
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["node", "vitest/globals", "vitest/importMeta", "vite/client", "vitest"]
  },
  "include": ["src/**/*", "vitest.config.mts"],
  "exclude": ["dist", "coverage", "node_modules"]
}
